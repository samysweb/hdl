session Heterogeneous_Dynamic_Logic = HOL +
  options [timeout = 300, document = pdf, document_output = "output", document_variants = "outline=/proof,/ML"]
  sessions
    "HOL-Eisbach"
    Deep_Learning
  theories 
    (* Locales for Structuring DL *)
    "FirstOrder" (* FOL *)
    "DynamicLogicCore" (* DL basics *)
    "DynamicLogic"
    "DynamicLogicBV" (* DL with finite support (i.e. BV) *)
    "DynamicLogicProof" (* Additional proof primitives *)
    "DynamicLogicHelpers" (*Auxiliary lemmas*)

    "HavocDynamicLogic" (* Extending DL with more complex programs *)
    "KATDynamicLogic"
    "NatKATDynamicLogic" (* Assuming natural numbers for C rule *)
    "ConverseDynamicLogic" (* Lifting for DL with converse *)
    "HeterogeneousDynamicLogic" (* Heterogeneous Construction *)


    (*"DifferentialDL" Instantiating Differential Dynamic Logic as DL *)
    (* KAT Style reasoning *)
    "DLRewriting"
    "KATRewriting"
    "HeterogeneousRewriting"
    "ExtensionalDynamicLogic"

    (* Instantiations *)
    "InterpDL" (* DLs with fixed interpretation *)
    "PDL" (* PDL *)
    "SemiRingFOL" (* just FOL with semiring values (e.g. Int/Nat/Real) *)
    "SemiRingDL" (* FODL with semiring values *)
    "SemiRingHDL" (* HDL with 2x FODL with semiring values *)


    (* Neural Dynamic Logic *)
    "DynamicTheorySum" (* Combination of two dynamic theories *)
    "SemiRingNDL"
    "SemiRingNDLCompile"
    "SemiRingNDLExample"

    (* VerSAILLE *)
    "DynamicLogicVersaille"
    "DynamicLogicVersailleSyntactic"
    "SemiRingVersailleExample"

    (* Information Flow *)
    "CounterfactualsInfFlow"
  document_files
    "root.tex"
    "root.bib"

